  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GrowthHub | Digital Marketing &amp; Growth Studio</title>
  <meta name="description" content="GrowthHub helps small businesses, startups, and personal brands grow through performance marketing and social media.">
  <meta name="robots" content="index,follow">
  <meta property="og:title" content="GrowthHub | Digital Marketing &amp; Growth Studio">
  <meta property="og:description" content="Performance marketing and social media strategies for small businesses, startups, and personal brands.">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary">
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&amp;family=Sora:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet">
  <style>
    :root{--ink:#070A0F;--panel:#0D1117;--card:#111720;--line:#26303c;--text:#F5F7FA;--muted:#9CA6B5;--cyan:#00D4FF;--violet:#6C63FF;--green:#3DFF9A}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{width:100%;margin:0;background:var(--ink);color:var(--text);font-family:Manrope,sans-serif;overflow-x:hidden}h1,h2,h3,h4,.display{font-family:Sora,sans-serif}button,input,textarea,select{font:inherit}button{cursor:pointer}:focus-visible{outline:2px solid var(--cyan);outline-offset:4px}
    .shell{width:100%;max-width:1240px;margin:0 auto;padding:0 24px}.section{padding:104px 0;border-top:1px solid rgba(156,166,181,.11)}.eyebrow{color:var(--cyan);font-size:.7rem;font-weight:800;letter-spacing:.18em}.muted{color:var(--muted)}
    .grid-atmosphere{background-image:linear-gradient(rgba(0,212,255,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(0,212,255,.045) 1px,transparent 1px),radial-gradient(circle at 75% 20%,rgba(108,99,255,.16),transparent 25%);background-size:46px 46px,46px 46px,auto}
    .panel{background:rgba(17,23,32,.8);border:1px solid rgba(156,166,181,.16)}.btn-primary,.btn-secondary{display:inline-flex;align-items:center;justify-content:center;gap:.55rem;border-radius:999px;padding:.93rem 1.2rem;letter-spacing:.08em;font-size:.72rem;font-weight:800;transition:.25s}.btn-primary{background:#6C63FF;border:1px solid #6C63FF;color:#fff;box-shadow:0 0 30px rgba(108,99,255,.28)}.btn-primary:hover{transform:translateY(-2px);box-shadow:0 0 40px rgba(0,212,255,.26)}.btn-secondary{border:1px solid rgba(156,166,181,.32);color:var(--text)}.btn-secondary:hover{border-color:var(--cyan);color:var(--cyan);transform:translateY(-2px)}
    .navlink{color:var(--muted);font-size:.72rem;font-weight:800;letter-spacing:.08em;transition:.2s}.navlink:hover{color:#fff}.reveal{opacity:0;transform:translateY(16px);transition:opacity .65s ease,transform .65s ease}.reveal.show{opacity:1;transform:none}
    .dashboard{position:relative;min-height:495px;overflow:hidden;border:1px solid rgba(0,212,255,.36);border-radius:28px;background:linear-gradient(145deg,#121b26,#080d13 70%);box-shadow:inset 0 0 48px rgba(0,212,255,.04),0 30px 80px rgba(0,0,0,.4);animation:float 6s ease-in-out infinite}.dashboard:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(0,212,255,.065) 1px,transparent 1px),linear-gradient(90deg,rgba(0,212,255,.065) 1px,transparent 1px);background-size:34px 34px;mask-image:linear-gradient(to bottom,black,transparent)}
    .metric{position:relative;border:1px solid rgba(156,166,181,.14);border-radius:15px;padding:13px;background:rgba(7,10,15,.62)}.metric b{display:block;margin-top:4px;font-family:Sora;font-size:1.25rem}.line-path{stroke-dasharray:700;stroke-dashoffset:700;animation:draw 2.4s ease forwards}.node{animation:pulse 2.2s infinite}.network-line{stroke-dasharray:4 8;animation:dash 5s linear infinite}
    .service{overflow:hidden;transition:.28s}.service:hover,.service.open{transform:translateY(-4px);border-color:rgba(0,212,255,.58);box-shadow:0 18px 42px rgba(0,0,0,.24)}.service-detail{display:grid;grid-template-rows:0fr;transition:.32s}.service-detail>div{overflow:hidden}.service.open .service-detail{grid-template-rows:1fr}.service-arrow{transition:.28s}.service.open .service-arrow{transform:translate(3px,-3px);color:var(--cyan)}
    .portrait-frame{min-height:390px;position:relative;overflow:hidden;border:1px dashed rgba(0,212,255,.52);background:radial-gradient(circle at 50% 38%,rgba(108,99,255,.22),transparent 30%),linear-gradient(145deg,#101824,#090d13)}.portrait-frame:before{content:"";position:absolute;inset:15px;border:1px solid rgba(0,212,255,.14);border-radius:18px}.portrait-frame:after{content:"EDITABLE PORTRAIT PLACEHOLDER";position:absolute;inset:0;display:grid;place-items:center;color:rgba(245,247,250,.37);font-size:.68rem;font-weight:800;letter-spacing:.16em}
    .timeline-step{position:relative}.timeline-step:before{content:"";position:absolute;z-index:-1;top:19px;left:0;right:0;height:1px;background:#26303c}.timeline-number{display:grid;place-items:center;width:39px;height:39px;border:1px solid var(--violet);border-radius:50%;background:var(--card);color:var(--cyan);font-size:.7rem;font-weight:800}
    .input{width:100%;margin-top:.45rem;border:1px solid rgba(156,166,181,.24);border-radius:10px;background:#090d13;color:#F5F7FA;padding:.84rem .9rem}.input:focus{outline:none;border-color:var(--cyan)}.input::placeholder{color:#667181}.faq-answer{display:grid;grid-template-rows:0fr;transition:.25s}.faq-answer>div{overflow:hidden}.faq.open .faq-answer{grid-template-rows:1fr}.faq-chevron{transition:.25s}.faq.open .faq-chevron{transform:rotate(180deg)}
    .filter.active{border-color:var(--cyan);background:rgba(0,212,255,.1);color:var(--cyan)}.mobile-bar{display:none}@keyframes draw{to{stroke-dashoffset:0}}@keyframes pulse{50%{opacity:.4;r:7}}@keyframes dash{to{stroke-dashoffset:-100}}@keyframes float{50%{transform:translateY(-7px)}}
    @media(max-width:800px){.shell{padding:0 18px}.section{padding:76px 0}.desktop-nav{display:none}.mobile-toggle{display:inline-flex}.hero-grid{grid-template-columns:1fr!important}.dashboard{min-height:420px}.timeline{grid-template-columns:1fr!important;gap:26px}.timeline-step{padding-left:58px}.timeline-step:before{width:1px;height:calc(100% + 27px);left:19px;top:39px}.timeline-number{position:absolute;left:0;top:0}.mobile-bar{display:grid}}
    @media(min-width:801px){.mobile-toggle,.mobile-menu{display:none!important}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{animation-duration:.01ms!important;transition-duration:.01ms!important}.reveal{opacity:1;transform:none}}
  </style>
