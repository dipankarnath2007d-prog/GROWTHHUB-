  <main id="main-content">
   <section id="home" class="grid-atmosphere relative overflow-hidden">
    <div class="shell hero-grid grid min-h-[calc(100*min(var(--vh,1vh),1vh))] grid-cols-2 items-center gap-12 py-20">
     <div class="reveal">
      <span data-template-id="hero-badge" class="canva-tag inline-flex rounded-full border border-cyan-300/30 px-3 py-2 text-[10px] font-bold tracking-[.16em]" style="background: rgba(0, 212, 255, 0.05); color: rgb(0, 212, 255); font-weight: 700;">DIGITAL GROWTH STUDIO</span>
      <h1 data-template-id="hero-title" class="canva-text mt-6 max-w-3xl text-5xl font-extrabold leading-[1.03] tracking-[-.065em] md:text-7xl whitespace-pre-line" style="color: rgb(245, 247, 250); font-weight: 800;">TURN ATTENTION
INTO GROWTH.</h1>
      <p data-template-id="hero-subtitle" class="canva-text mt-6 max-w-xl text-lg leading-8" style="color: rgb(156, 166, 181);">Smart digital marketing strategies designed to help businesses reach the right audience, generate opportunities and grow online.</p>
      <div class="mt-8 flex flex-wrap gap-3"><a data-template-id="hero-primary" class="canva-button btn-primary" href="#contact" style="background: rgb(108, 99, 255); color: rgb(255, 255, 255); font-weight: 700;">START A PROJECT</a><a data-template-id="hero-secondary" class="canva-button btn-secondary" href="#services" style="background: transparent; color: rgb(245, 247, 250); font-weight: 700;">EXPLORE SERVICES</a>
      </div>
      <p data-template-id="hero-services-line" class="canva-text mt-8 text-xs font-bold tracking-wide" style="color: rgb(156, 166, 181); font-weight: 700;">GOOGLE ADS • META ADS • SOCIAL MEDIA • LEAD GENERATION</p>
     </div>
     <div class="reveal" style="transition-delay:.12s">
      <div class="dashboard" aria-label="Marketing analytics dashboard using fictional demo data">
       <div class="relative flex items-center justify-between border-b border-white/10 px-5 py-4 text-[10px] font-bold tracking-[.13em]"><span class="text-[#00D4FF]">GROWTH SIGNALS</span><span class="text-[#3DFF9A]">● DEMO DATA</span>
       </div>
       <div class="relative grid grid-cols-2 gap-3 p-4">
        <div class="metric"><span class="text-[10px] uppercase tracking-widest text-[#9CA6B5]">Reach</span><b>42.5K</b>
        </div>
        <div class="metric"><span class="text-[10px] uppercase tracking-widest text-[#9CA6B5]">Clicks</span><b>1,840</b>
        </div>
        <div class="metric"><span class="text-[10px] uppercase tracking-widest text-[#9CA6B5]">Leads</span><b>96</b>
        </div>
        <div class="metric"><span class="text-[10px] uppercase tracking-widest text-[#9CA6B5]">CTR</span><b>4.3%</b>
        </div>
       </div>
       <div class="relative mx-4 h-48 overflow-hidden rounded-2xl border border-white/10 bg-violet-400/5">
        <span class="absolute left-4 top-4 z-10 text-[10px] font-bold tracking-[.13em] text-[#9CA6B5]">CAMPAIGN PERFORMANCE</span>
        <svg class="h-full w-full" viewBox="0 0 600 180" preserveAspectRatio="none" aria-hidden="true">
         <path d="M0,148 C55,145 70,105 115,119 S180,78 230,94 S300,132 350,70 S418,105 468,58 S540,55 600,17" fill="none" stroke="#00D4FF" stroke-width="3" class="line-path"></path> <path d="M0,156 C70,150 110,136 164,126 S250,124 310,103 S390,115 460,84 S548,98 600,68" fill="none" stroke="#6C63FF" stroke-width="2" opacity=".8" class="line-path"></path> <circle cx="468" cy="58" r="5" fill="#3DFF9A" class="node"></circle>
        </svg>
       </div>
       <div class="relative mx-4 mt-4 h-20 overflow-hidden rounded-xl border border-white/10">
        <svg class="h-full w-full" viewBox="0 0 600 100" aria-hidden="true">
         <line x1="110" y1="42" x2="250" y2="18" stroke="#00D4FF" opacity=".45" class="network-line"></line><line x1="250" y1="18" x2="420" y2="57" stroke="#6C63FF" opacity=".45" class="network-line"></line><line x1="110" y1="42" x2="345" y2="82" stroke="#3DFF9A" opacity=".35" class="network-line"></line><circle cx="110" cy="42" r="7" fill="#00D4FF"></circle><circle cx="250" cy="18" r="7" fill="#6C63FF"></circle><circle cx="420" cy="57" r="7" fill="#3DFF9A"></circle><circle cx="345" cy="82" r="7" fill="#00D4FF"></circle>
        </svg>
       </div>
       <div data-template-id="hero-dashboard-flow" class="canva-banner absolute bottom-4 left-4 right-4 rounded-lg border border-violet-300/25 px-3 py-2 text-center text-[9px] font-bold tracking-[.12em]" style="background: rgba(108, 99, 255, 0.12); color: rgb(215, 212, 255); font-weight: 700;">TRAFFIC → ATTENTION → LEADS → GROWTH</div>
      </div>
      <p data-template-id="hero-demo-note" class="canva-text mt-3 text-center text-[10px] font-bold tracking-[.13em]" style="color: rgb(156, 166, 181); font-weight: 700;">DEMO DATA — FOR PRESENTATION ONLY</p>
     </div>
    </div>
   </section>
   <section id="services" class="section">
    <div class="shell">
     <div class="reveal max-w-3xl">
      <p class="eyebrow">01 / SERVICES</p>
      <h2 data-template-id="services-heading" class="canva-text mt-4 text-3xl font-bold tracking-[-.05em] md:text-5xl" style="color: rgb(245, 247, 250); font-weight: 700;">DIGITAL MARKETING BUILT FOR GROWTH.</h2>
      <p data-template-id="services-copy" class="canva-text mt-5 max-w-2xl leading-7" style="color: rgb(156, 166, 181);">Focused digital services designed around clear goals, practical execution, and smarter growth decisions.</p>
     </div>
     <div class="mt-12 grid gap-4 md:grid-cols-2">
      <article class="service panel rounded-2xl p-6 reveal"><button class="service-toggle w-full text-left" type="button" aria-expanded="false">
        <div class="flex justify-between gap-4">
         <div><span class="text-xs font-bold text-[#00D4FF]">SERVICE 01</span>
          <h3 data-template-id="service-1-title" class="canva-text mt-3 text-xl font-bold" style="color: rgb(245, 247, 250); font-weight: 700;">GOOGLE ADS</h3>
          <p data-template-id="service-1-copy" class="canva-text mt-3 leading-7" style="color: rgb(156, 166, 181);">Reach customers actively searching for your products and services.</p>
         </div><i data-lucide="arrow-up-right" class="service-arrow shrink-0"></i>
        </div></button>
       <div class="service-detail">
        <div>
         <p class="mt-5 border-t border-white/10 pt-5 text-sm leading-7 text-[#9CA6B5]">Search campaigns · keyword strategy · ad copy · conversion tracking · ongoing optimisation.</p>
        </div>
       </div>
      </article>
      <article class="service panel rounded-2xl p-6 reveal"><button class="service-toggle w-full text-left" type="button" aria-expanded="false">
        <div class="flex justify-between gap-4">
         <div><span class="text-xs font-bold text-[#00D4FF]">SERVICE 02</span>
          <h3 data-template-id="service-2-title" class="canva-text mt-3 text-xl font-bold" style="color: rgb(245, 247, 250); font-weight: 700;">META ADS</h3>
          <p data-template-id="service-2-copy" class="canva-text mt-3 leading-7" style="color: rgb(156, 166, 181);">Build targeted Facebook and Instagram campaigns.</p>
         </div><i data-lucide="arrow-up-right" class="service-arrow shrink-0"></i>
        </div></button>
       <div class="service-detail">
        <div>
         <p class="mt-5 border-t border-white/10 pt-5 text-sm leading-7 text-[#9CA6B5]">Facebook and Instagram campaigns · audience research · creative testing · retargeting.</p>
        </div>
       </div>
      </article>
      <article class="service panel rounded-2xl p-6 reveal"><button class="service-toggle w-full text-left" type="button" aria-expanded="false">
        <div class="flex justify-between gap-4">
         <div><span class="text-xs font-bold text-[#00D4FF]">SERVICE 03</span>
          <h3 data-template-id="service-3-title" class="canva-text mt-3 text-xl font-bold" style="color: rgb(245, 247, 250); font-weight: 700;">SOCIAL MEDIA</h3>
          <p data-template-id="service-3-copy" class="canva-text mt-3 leading-7" style="color: rgb(156, 166, 181);">Create a stronger and more consistent digital presence.</p>
         </div><i data-lucide="arrow-up-right" class="service-arrow shrink-0"></i>
        </div></button>
       <div class="service-detail">
        <div>
         <p class="mt-5 border-t border-white/10 pt-5 text-sm leading-7 text-[#9CA6B5]">Content direction · consistency systems · platform-aware publishing · engagement thinking.</p>
        </div>
       </div>
      </article>
      <article class="service panel rounded-2xl p-6 reveal"><button class="service-toggle w-full text-left" type="button" aria-expanded="false">
        <div class="flex justify-between gap-4">
         <div><span class="text-xs font-bold text-[#00D4FF]">SERVICE 04</span>
          <h3 data-template-id="service-4-title" class="canva-text mt-3 text-xl font-bold" style="color: rgb(245, 247, 250); font-weight: 700;">SOCIAL MEDIA OPTIMIZATION</h3>
          <p data-template-id="service-4-copy" class="canva-text mt-3 leading-7" style="color: rgb(156, 166, 181);">Optimize profiles, content structure and audience engagement.</p>
         </div><i data-lucide="arrow-up-right" class="service-arrow shrink-0"></i>
        </div></button>
       <div class="service-detail">
        <div>
         <p class="mt-5 border-t border-white/10 pt-5 text-sm leading-7 text-[#9CA6B5]">Profile positioning · bio structure · content structure · audience engagement foundations.</p>
        </div>
       </div>
      </article>
      <article class="service panel rounded-2xl p-6 reveal"><button class="service-toggle w-full text-left" type="button" aria-expanded="false">
        <div class="flex justify-between gap-4">
