     <div class="panel rounded-3xl p-6 md:p-8 reveal">
      <form id="leadForm" novalidate="">
       <div id="formFields">
        <div class="grid gap-5 md:grid-cols-2">
         <div><label for="fullName">Name *</label><input class="input" id="fullName" name="full_name" autocomplete="name">
          <p id="fullNameError" class="mt-1 text-xs text-red-300"></p>
         </div>
         <div><label for="businessName">Business Name *</label><input class="input" id="businessName" name="business_name">
          <p id="businessNameError" class="mt-1 text-xs text-red-300"></p>
         </div>
         <div><label for="phone">Phone *</label><input class="input" id="phone" name="phone" inputmode="tel" autocomplete="tel">
          <p id="phoneError" class="mt-1 text-xs text-red-300"></p>
         </div>
         <div><label for="email">Email *</label><input class="input" id="email" name="email" type="email" autocomplete="email">
          <p id="emailError" class="mt-1 text-xs text-red-300"></p>
         </div>
         <div><label for="website">Website / Instagram</label><input class="input" id="website" name="website_or_instagram">
         </div>
         <div><label for="businessType">Business Type *</label><input class="input" id="businessType" name="business_type">
          <p id="businessTypeError" class="mt-1 text-xs text-red-300"></p>
         </div>
         <div><label for="serviceRequired">Service Required *</label><select class="input" id="serviceRequired" name="services_needed"><option value="">Select a service</option><option>Google Ads</option><option>Meta Ads (Facebook &amp; Instagram)</option><option>Social Media Marketing</option><option>Social Media Optimization</option><option>Lead Generation</option><option>Campaign Management</option><option>Digital Marketing Strategy</option><option>Conversion Optimization</option><option>Marketing Consultation</option></select>
          <p id="serviceRequiredError" class="mt-1 text-xs text-red-300"></p>
         </div>
         <div><label for="budget">Monthly Ad Budget *</label><select class="input" id="budget" name="budget"><option value="">Select a range</option><option>Exploring options</option><option>Under ₹20,000</option><option>₹20,000–₹50,000</option><option>₹50,000–₹1,00,000</option><option>Above ₹1,00,000</option></select>
          <p id="budgetError" class="mt-1 text-xs text-red-300"></p>
         </div>
         <div class="md:col-span-2"><label for="goal">Business Goal *</label><input class="input" id="goal" name="main_goal">
          <p id="goalError" class="mt-1 text-xs text-red-300"></p>
         </div>
         <div class="md:col-span-2"><label for="message">Message *</label><textarea class="input min-h-28" id="message" name="message"></textarea>
          <p id="messageError" class="mt-1 text-xs text-red-300"></p>
         </div>
         <div class="absolute -left-[9999px]" aria-hidden="true"><label for="companyWebsite">Leave this field empty</label><input id="companyWebsite" tabindex="-1" autocomplete="off">
         </div>
        </div><label class="mt-6 flex items-start gap-3 text-xs leading-5 text-[#9CA6B5]"><input id="consent" class="mt-1 h-4 w-4 accent-[#6C63FF]" type="checkbox"><span>I consent to the use of my submitted details to discuss this project request.</span></label>
        <p id="consentError" class="mt-1 text-xs text-red-300"></p>
        <p id="formMessage" class="mt-4 text-sm" role="status" aria-live="polite"></p><button data-template-id="form-submit" class="canva-button btn-primary mt-5 w-full" type="submit" style="background: rgb(108, 99, 255); color: rgb(255, 255, 255); font-weight: 700;">SEND PROJECT DETAILS →</button>
       </div>
       <div id="formSuccess" class="hidden py-12 text-center"><i data-lucide="circle-check-big" class="mx-auto h-12 w-12 text-[#3DFF9A]"></i>
        <h3 data-template-id="form-success" class="canva-text mt-6 text-xl font-bold" style="color: rgb(245, 247, 250); font-weight: 700;">THANK YOU. YOUR PROJECT REQUEST HAS BEEN RECEIVED.</h3>
       </div>
      </form>
     </div>
    </div>
